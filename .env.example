# Environnement d'exécution
NODE_ENV=production
PORT=3000

# Base de données PostgreSQL (Prisma)
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/parking_bcrg?schema=public"

# Sécurité interne Parking (JWT & Pepper pour mots de passe locaux)
JWT_SECRET="votre_cle_secrete_ultra_securisee_parking"
JWT_EXPIRES_IN="24h"
PASSWORD_PEPPER="votre_pepper_pour_le_hachage"

# Administrateur local initial (de secours)
ADMIN_NOM="Admin"
ADMIN_PRENOM="Principal"
ADMIN_MATRICULE="ADMIN-001"
ADMIN_PASSWORD="votre_mot_de_passe_admin"
ADMIN_DOIT_CHANGER_MDP="false"

# Fédération Single Sign-On (SSO) BCRG HUB
BCRG_HUB_URL="http://localhost:5001"
# Option A (Recommandée) : Découverte automatique des clés publiques via JWKS
BCRG_HUB_JWKS_URL="http://localhost:5001/api/security/.well-known/jwks.json"

# Option B (Statique) : Fichier ou chaîne PEM de la clé publique du HUB
BCRG_HUB_PUBLIC_KEY_PATH="./src/config/bcrg_hub_public.pem"
# BCRG_HUB_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Option C (Repli HMAC) : Secret partagé symétrique si RS256 non utilisé
BCRG_HUB_JWT_SECRET="supersecret_sso_portal_key_2026"

